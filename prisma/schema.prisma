// ============================================
// Retention Engine — Activity Tracking (faith-agnostic)
// ============================================
//
// The engine is event-sourced. `activity_events` is the only source of truth;
// `daily_rollups` and `streak_states` are caches that may be deleted and
// rebuilt by replaying the event stream. The contract these four tables serve
// is frozen in docs/contracts/activity-api.md -- read it before changing
// anything here.
//
// No foreign key to `users`: this follows DhikrCounter and the rest of the
// faith tables, which carry a bare `user_id` with no relation. Adding one
// would require a back-relation field on User.

/// Append-only, immutable. One row per in-app act of worship.
///
/// `local_day` -- not `occurred_at` -- is what streaks count: the device
/// stamps the day the user believed it was, plus the IANA zone it believed it
/// was in, at the moment of the act (contract §2.1, §2.2).
model ActivityEvent {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  faithId       String   @map("faith_id") // islam | hindu
  activityType  String   @map("activity_type") // quran_verse | prayer | dhikr | gita_shloka | sandhya | japa_mala
  quantity      Int      @default(1)
  occurredAt    DateTime @map("occurred_at") // the real instant, stored UTC
  localDay      DateTime @map("local_day") @db.Date // the user's day -- what streaks count
  timezone      String // IANA zone name, e.g. Asia/Kolkata. Stored, never used to validate local_day.
  sourceRef     String?  @map("source_ref") // "quran:2:148", "prayer:fajr"; load-bearing from Phase 2
  clientEventId String   @map("client_event_id") // UUID v4 minted on the device
  createdAt     DateTime @default(now()) @map("created_at") // server receipt; never exposed

  /// Idempotency (contract §4.3). First write wins: a replayed batch is free,
  /// and a re-sent clientEventId with a different payload does not overwrite.
  @@unique([userId, clientEventId])
  /// Serves /today counts and /history ranges. faith_id is in the key because
  /// every read in the contract is faith-scoped and a user may hold both.
  @@index([userId, faithId, localDay])
  /// Serves goal progress: SUM(quantity) for one activity type on one day.
  @@index([userId, faithId, activityType, localDay])
  /// Serves "this user's most recent event", which the nightly rollup runs
  /// twice per (user, faith) pair and `PUT /goal` runs once per call:
  ///   WHERE user_id = ? ORDER BY occurred_at DESC LIMIT 1
  /// The three keys above are all faith-scoped and all sort on `local_day`, so
  /// none of them can serve that sort -- without this index the query is a
  /// filter-then-sort over the user's entire event history. Ascending, not
  /// `sort: Desc`: `user_id` is an equality predicate rather than a sort key,
  /// so there is no mixed-direction sort to express, and Postgres walks a btree
  /// backwards for `ORDER BY ... DESC LIMIT 1` at no cost. Deliberately NOT
  /// faith-scoped -- both call sites ask which zone the person is in, which is
  /// a fact about where they are standing, not about a content pack.
  @@index([userId, occurredAt])
  @@map("activity_events")
}

/// Cache of a closed day, written by the nightly rollup (Task 1.7).
/// Deletable: every row is recomputable from `activity_events` plus the
/// `user_goals` row in force on `local_day`. Any day not yet persisted here is
/// computed on read and returned identically (contract §2.8).
model DailyRollup {
  userId     String   @map("user_id")
  faithId    String   @map("faith_id")
  localDay   DateTime @map("local_day") @db.Date
  counts     Json     @default("{}") // { "quran_verse": 12, "prayer": 5 } -- zero totals are absent keys
  points     Int      @default(0) // weighting undecided; no Phase 1 response returns it (§2.9)
  goalMet    Boolean  @default(false) @map("goal_met")
  computedAt DateTime @default(now()) @updatedAt @map("computed_at")

  @@id([userId, faithId, localDay])
  @@map("daily_rollups")
}

/// Cache of the streak projection. Deletable and recomputable, like DailyRollup.
model StreakState {
  userId         String    @map("user_id")
  faithId        String    @map("faith_id")
  current        Int       @default(0)
  longest        Int       @default(0) // never decreases
  lastGoalMetDay DateTime? @map("last_goal_met_day") @db.Date // null if never
  freezesLeft    Int       @default(2) @map("freezes_left") // 0-2, granted not earned (§2.6)
  freezeResetOn  DateTime? @map("freeze_reset_on") @db.Date // first day of next month, user's zone
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@id([userId, faithId])
  @@map("streak_states")
}

/// Effective-dated and append-only. NOT one mutable current row.
///
/// A goal change is not retroactive (contract §7.4): days already closed keep
/// the `goalMet` they were closed with. A single mutable row cannot express
/// that -- a replay would recompute every past day against today's target, so
/// lowering a goal to 1 would retroactively manufacture a streak, and the
/// Task 1.5 replay-equivalence property would be false by construction.
///
/// Semantics: half-open interval [effectiveFrom, effectiveTo). `effectiveTo`
/// null means "still in force". PUT /goal closes the open row by setting its
/// effectiveTo to the new row's effectiveFrom and inserts the new row, both in
/// one transaction. A second PUT on the same local day upserts on the unique
/// key rather than inserting a second row.
///
/// Rollup and replay read the goal in force on day D with:
///   WHERE user_id = ? AND faith_id = ? AND effective_from <= D
///   ORDER BY effective_from DESC LIMIT 1
/// which is total and single-valued whatever `effective_to` holds, so replay
/// correctness never depends on the bookkeeping column being right.
model UserGoal {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  faithId       String    @map("faith_id")
  goalType      String    @map("goal_type") // verses | prayers | dhikr | shlokas | sandhyas | malas
  target        Int
  effectiveFrom DateTime  @map("effective_from") @db.Date // a localDay, inclusive
  effectiveTo   DateTime? @map("effective_to") @db.Date // a localDay, exclusive; null = in force
  createdAt     DateTime  @default(now()) @map("created_at") // surfaces as `updatedAt` on PUT /goal

  /// The overlap guard, and the whole reason the lookup above is unambiguous:
  /// two goals for one faith can never start on the same day, so the ORDER BY
  /// above can never tie. This is the only overlap a correct PUT can produce.
  @@unique([userId, faithId, effectiveFrom])
  @@map("user_goals")
}

// ============================================
// Curated Collections (cross-faith)
// team/curated-collections-spec.md §1.2
// ============================================

/// An **ordered**, **occasion-bound** sequence of devotional items, each
/// carrying its own citation, its own repeat count and its own warrant for
/// being in that sequence (spec §1.1).
///
/// Server-backed rather than a client constant because the hard repo rule is
/// that scripture text never lives in the client (spec §0.2, §1.5): a
/// Qur'an-only collection *could* be a constant since `(surahId, ayah)` is a
/// stable reference, but the first item that is a du'ā, dhikr, stotra or
/// mantra needs its text, and a uuid is not reproducible across environments.
///
/// House convention: the schema declares zero Prisma enums. Every vocabulary
/// below is a `String` whose legal values are listed in a comment, with the
/// real enumeration as a TypeScript const —
/// `src/faiths/collections/collection-vocabulary.ts`.
model Collection {
  id               String    @id @default(uuid())
  slug             String    @unique
  faithId          String    @map("faith_id") // islam | hindu
  title            String
  subtitle         String?
  description      String?   @db.Text
  occasionType     String    @map("occasion_type") // nightly | morning | evening |
  //                                                  after_prayer | weekday | hijri |
  //                                                  panchang | festival | situational | evergreen
  occasionConfig   Json?     @map("occasion_config") // spec §3.1 window shapes
  orderSemantics   String    @default("sequence") @map("order_semantics") // sequence | set
  provenanceClass  String    @map("provenance_class") // transmitted | assembled | thematic
  reviewStatus     String    @default("draft") @map("review_status")
  //                                                  draft | self_reviewed | scholar_approved |
  //                                                  flagged | retired
  //                           `draft` is NEVER served (spec §5.1) — both read
  //                           queries filter it out, and so does the verifier.
  curatedBy        String?   @map("curated_by")
  curatedAt        DateTime? @map("curated_at")
  reviewedBy       String?   @map("reviewed_by")
  reviewedAt       DateTime? @map("reviewed_at")
  artworkKey       String?   @map("artwork_key")
  estimatedMinutes Int?      @map("estimated_minutes")
  priority         Int       @default(0) // Today tie-break, higher wins
  sortOrder        Int       @default(0) @map("sort_order")
  /// Database-controlled home-screen placement. **Several collections may be
  /// flagged at once**; `sortOrder` (asc) is what orders them when more than
  /// one is, which is why this is a plain boolean and not a nullable slot
  /// number. Exposed on both list endpoints and on the detail endpoint
  /// alongside `sortOrder`.
  ///
  /// Additive and nullable-safe: `@default(false)` means every existing row
  /// answers "no" without a backfill, and a client that has not learned the
  /// field yet is unaffected.
  ///
  /// **Deploy the migration BEFORE the code.** Prisma selects every scalar of
  /// a model on an unselected `findMany`, so the moment the code knows about
  /// this column it is in the SELECT list of both collections endpoints — and
  /// `vercel.json` runs no migration step. Code-before-migration is a 500 on
  /// GET /api/v1/{islam,hindu}/collections, not a missing field.
  showOnHome       Boolean   @default(false) @map("show_on_home")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  items CollectionItem[]

  @@index([faithId, isActive, occasionType])
  @@map("collections")
}

/// One item in a collection. The editorial unit of review is the **item**, not
/// the collection (spec §5.2), which is why `citation`, `grading`,
/// `translationSource` and `note` live here.
///
/// `repeatCount` is the field a Qur'an-shaped model would have missed and is
/// **not optional** (spec §1.2). Morning adhkar is ×3/×7/×10/×100, and the
/// seeded `Dua` rows currently encode counts in English prose inside
/// `textEnglish` ("…Recite three times in the evening."), which is
/// unrenderable, uncountable and untranslatable. It lives on the item rather
/// than on `Dua` because the same du'ā carries a different count in different
/// collections.
model CollectionItem {
  id           String @id @default(uuid())
  collectionId String @map("collection_id")
  /// 1..n, meaningful. Order is semantic, not presentational — there is no
  /// shuffle and no "random item from this collection" (spec §1.1). The
  /// `@@unique([collectionId, sequence])` below is what makes that structural.
  sequence     Int
  refType      String @map("ref_type") // surah | ayah_range | dua | dhikr |
  //                                      allah_name | hadith |
  //                                      hindu_verse_range | stotra | mantra | text

  // Qur'an refs — resolved through QuranVerse.@@unique([surahId, verseNumber])
  surahId   Int? @map("surah_id")
  ayahStart Int? @map("ayah_start") // null + surahId   => whole surah
  ayahEnd   Int? @map("ayah_end") // null + ayahStart => single ayah

  // Hindu scripture refs — resolved through HinduText.slug then
  // HinduTextChapter.@@unique([textId, chapterNumber])
  hinduTextSlug String? @map("hindu_text_slug") // e.g. 'bhagavad-gita'
  chapterNumber Int?    @map("chapter_number")
  verseStart    Int?    @map("verse_start")
  verseEnd      Int?    @map("verse_end")

  // Slug-addressed rows (dua, stotra, mantra, dhikr)
  refSlug String? @map("ref_slug")
  /// uuid fallback. Seeds MUST prefer `refSlug` — a uuid is not reproducible
  /// across environments, which is the whole reason `Dua.slug` exists.
  refId   String? @map("ref_id")

  repeatCount       Int     @default(1) @map("repeat_count")
  label             String // 'Ayat al-Kursi'
  note              String? @db.Text // one sentence, spec §5.3 rule 6
  citation          String // 'Bukhari 2311'
  grading           String? // sahih | hasan | daif | customary | not_applicable
  translationSource String? @map("translation_source")
  isOptional        Boolean @default(false) @map("is_optional")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, sequence])
  @@index([collectionId])
  @@map("collection_items")
}
